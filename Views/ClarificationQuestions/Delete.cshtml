@model ClarificationQuestionDeleteViewModel
@{
    ViewData["Title"] = "Delete Clarification Question";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="ClarificationQuestions" asp-action="Index">Clarification Questions</a><span>/</span>
        <a asp-action="Details" asp-route-id="@Model.Id">@Model.SlotName</a><span>/</span>
        <strong>Delete</strong>
    </div>
    <h1 class="page-heading">Delete clarification question</h1>
    <p class="detail-panel__summary">This permanently removes the selected clarification question from the seeded working dataset.</p>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Confirmation</div>
        <h2 class="detail-panel__title">@Model.SlotName</h2>
        <p class="detail-panel__summary">@Model.Prompt</p>
        <p class="detail-panel__summary">@Model.Reason</p>
        @if (!string.IsNullOrWhiteSpace(Model.Answer))
        {
            <p class="detail-panel__summary"><strong>Answer:</strong> @Model.Answer</p>
        }
    </article>

    <article class="detail-panel">
        <div class="section-header__eyebrow">Context</div>
        <ul class="stack-list">
            <li><strong>Mission</strong><br />@Model.MissionName</li>
            <li><strong>Answered</strong><br />@(Model.IsAnswered ? "Yes" : "No")</li>
            <li><strong>Created</strong><br />@Model.CreatedAtUtc.ToString("yyyy-MM-dd")</li>
            <li><strong>Answered at</strong><br />@(Model.AnsweredAtUtc.HasValue ? $"{Model.AnsweredAtUtc.Value:yyyy-MM-dd HH:mm} UTC" : "Pending")</li>
        </ul>
    </article>
</section>

<section class="surface-panel form-shell">
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="stack-form">
        <input asp-for="Id" type="hidden" />

        <div class="form-actions">
            <button type="submit" class="button-link button-link--danger">Delete question</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="button-link">Cancel</a>
        </div>
    </form>
</section>
