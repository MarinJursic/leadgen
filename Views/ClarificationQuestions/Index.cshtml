@model IReadOnlyList<ClarificationQuestion>
@{
    ViewData["Title"] = "Clarification Questions";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span><strong>Clarification Questions</strong>
    </div>
    <h1 class="page-heading">Clarification questions</h1>
    <div class="page-actions">
        <a asp-action="Create" class="button-link button-link--solid">New question</a>
    </div>
</div>

<section class="surface-panel">
    <partial name="_AjaxSearch" model="@(new AjaxSearchViewModel("questions", "Search slots, prompts, answers..."))" />
    <table class="list-table" data-search-table>
        <thead>
            <tr><th>Slot</th><th>Prompt</th><th>Answered</th><th>Created</th><th></th></tr>
        </thead>
        <tbody data-search-results>
            @foreach (var question in Model)
            {
                <tr>
                    <td><strong>@question.SlotName</strong></td>
                    <td>@question.Prompt</td>
                    <td>@(question.IsAnswered ? "Yes" : "No")</td>
                    <td>@question.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                    <td class="table-actions">
                        <a asp-action="Details" asp-route-id="@question.Id" class="button-link">Details</a>
                        <a asp-action="Edit" asp-route-id="@question.Id" class="button-link">Edit</a>
                        <a asp-action="Delete" asp-route-id="@question.Id" class="button-link button-link--danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
