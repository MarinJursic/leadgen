@model SwarmAgentDetailsViewModel
@{
    ViewData["Title"] = Model.Agent.CodeName;
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="SwarmAgents" asp-action="Index">Agents</a><span>/</span>
        <strong>@Model.Agent.CodeName</strong>
    </div>
    <h1 class="page-heading">@Model.Agent.CodeName</h1>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Agent profile</div>
        <ul class="stack-list">
            <li><strong>Role</strong><br />@Model.Agent.Role</li>
            <li><strong>Provider</strong><br />@Model.Agent.Provider</li>
            <li><strong>Temperature</strong><br />@Model.Agent.Temperature</li>
            <li><strong>Max concurrent tasks</strong><br />@Model.Agent.MaxConcurrentTasks</li>
            <li><strong>Current focus</strong><br />@Model.Agent.CurrentFocus</li>
        </ul>
    </article>
    <article class="detail-panel">
        <div class="section-header__eyebrow">Assignments</div>
        <ul class="stack-list">
            @foreach (var assignment in Model.Assignments)
            {
                <li>
                    <a asp-controller="MissionAgentAssignments" asp-action="Details" asp-route-id="@assignment.Id">@assignment.Responsibility</a><br />
                    @assignment.Status · @assignment.TokenBudget tokens
                </li>
            }
        </ul>
    </article>
</section>
