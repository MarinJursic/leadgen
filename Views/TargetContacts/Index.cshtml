@model IReadOnlyList<TargetContact>
@{
    ViewData["Title"] = "Target Contacts";
}

<div class="page-header">
    <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span><strong>Contacts</strong></div>
    <h1 class="page-heading">Target contacts</h1>
    <div class="page-actions">
        <a asp-action="Create" class="button-link button-link--solid">New contact</a>
    </div>
</div>

<section class="surface-panel">
    <partial name="_AjaxSearch" model="@(new AjaxSearchViewModel("contacts", "Search contacts, roles, departments..."))" />
    <table class="list-table" data-search-table>
        <thead>
            <tr><th>Contact</th><th>Role</th><th>Department</th><th>Decision maker</th><th></th></tr>
        </thead>
        <tbody data-search-results>
            @foreach (var contact in Model)
            {
                <tr>
                    <td><strong>@contact.FullName</strong><br /><span>@contact.OpportunitySummary</span></td>
                    <td>@contact.JobTitle</td>
                    <td>@contact.Department</td>
                    <td>@(contact.IsDecisionMaker ? "Yes" : "No")</td>
                    <td class="table-actions">
                        <a asp-action="Details" asp-route-id="@contact.Id" class="button-link">Details</a>
                        <a asp-action="Edit" asp-route-id="@contact.Id" class="button-link">Edit</a>
                        <a asp-action="Delete" asp-route-id="@contact.Id" class="button-link button-link--danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
