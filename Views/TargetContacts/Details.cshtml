@model TargetContactDetailsViewModel
@{
    ViewData["Title"] = Model.Contact.FullName;
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="TargetContacts" asp-action="Index">Contacts</a><span>/</span>
        <strong>@Model.Contact.FullName</strong>
    </div>
    <h1 class="page-heading">@Model.Contact.FullName</h1>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Contact profile</div>
        <ul class="stack-list">
            <li><strong>Company</strong><br />@(Model.Company?.Name ?? "Unknown")</li>
            <li><strong>Mission</strong><br />@(Model.Mission?.MissionName ?? "Unknown")</li>
            <li><strong>Job title</strong><br />@Model.Contact.JobTitle</li>
            <li><strong>Decision maker</strong><br />@(Model.Contact.IsDecisionMaker ? "Yes" : "No")</li>
            <li><strong>Observed</strong><br />@Model.Contact.LastObservedAtUtc.ToString("yyyy-MM-dd")</li>
        </ul>
    </article>
    <article class="detail-panel">
        <div class="section-header__eyebrow">Channels & evidence</div>
        <ul class="stack-list">
            <li><strong>Channels</strong><br />@Model.Contact.ContactChannels.Count</li>
            <li><strong>Evidence points</strong><br />@Model.Contact.EvidencePoints.Count</li>
            <li><strong>Dossiers</strong><br />@Model.Dossiers.Count</li>
        </ul>
    </article>
</section>
