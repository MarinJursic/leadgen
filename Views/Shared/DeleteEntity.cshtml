@model DeleteEntityViewModel
@{
    ViewData["Title"] = $"Delete {Model.EntityName}";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="@Model.ReturnController" asp-action="@Model.ReturnAction">@Model.EntityName</a><span>/</span>
        <strong>Delete</strong>
    </div>
    <h1 class="page-heading">Delete @Model.EntityName.ToLowerInvariant()</h1>
</div>

<section class="surface-panel form-shell delete-shell">
    <div>
        <div class="section-header__eyebrow">Confirmation</div>
        <h2 class="detail-panel__title">@Model.Title</h2>
        <p class="detail-panel__summary">@Model.Description</p>
    </div>

    @if (Model.Warnings.Count > 0)
    {
        <ul class="stack-list delete-warnings">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    }

    <form method="post" class="stack-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="button-link button-link--danger">Delete</button>
            <a asp-controller="@Model.ReturnController" asp-action="@Model.ReturnAction" class="button-link">Cancel</a>
        </div>
    </form>
</section>
