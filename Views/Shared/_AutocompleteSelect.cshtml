@model AutocompleteFieldViewModel

@{
    var fieldId = Html.Id(Model.Name);
    var displayId = $"{fieldId}_Display";
}

<div class="form-field autocomplete-field" data-autocomplete data-autocomplete-url="@Model.Endpoint">
    <label class="form-label" for="@displayId">@Model.Label</label>
    <input
        id="@displayId"
        class="form-input"
        type="text"
        value="@Model.DisplayValue"
        placeholder="@Model.Placeholder"
        autocomplete="off"
        data-autocomplete-input
        @(Model.IsRequired ? "required" : null) />
    <input
        id="@fieldId"
        name="@Model.Name"
        type="hidden"
        value="@(Model.Value.HasValue ? Model.Value.Value.ToString() : string.Empty)"
        data-autocomplete-value
        data-val="true"
        data-val-required="@Model.Label is required." />
    <div class="autocomplete-menu" data-autocomplete-menu></div>
    <span class="field-validation" data-valmsg-for="@Model.Name" data-valmsg-replace="true"></span>
</div>
