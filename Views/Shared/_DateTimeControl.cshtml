@using System.Globalization
@model DateTimeFieldViewModel

@{
    var fieldId = Html.Id(Model.Name);
    var displayId = $"{fieldId}_Display";
    var value = Model.Value;
    var isoValue = value.HasValue ? value.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture) : string.Empty;
}

<div class="form-field date-control" data-date-control data-include-time="@Model.IncludeTime.ToString().ToLowerInvariant()">
    <label class="form-label" for="@displayId">@Model.Label</label>
    <input
        id="@displayId"
        class="form-input"
        type="text"
        value="@isoValue"
        placeholder="dd.MM.yyyy HH:mm"
        autocomplete="off"
        data-date-display
        @(Model.IsRequired ? "required" : null) />
    <input
        id="@fieldId"
        name="@Model.Name"
        type="hidden"
        value="@isoValue"
        data-date-value
        data-val="true"
        data-val-required="@Model.Label is required." />
    <div class="date-picker" data-date-picker aria-hidden="true">
        <div class="date-picker__head">
            <button type="button" class="date-picker__nav" data-date-prev aria-label="Previous month">‹</button>
            <strong data-date-title></strong>
            <button type="button" class="date-picker__nav" data-date-next aria-label="Next month">›</button>
        </div>
        <div class="date-picker__week">
            <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
        </div>
        <div class="date-picker__grid" data-date-grid></div>
        @if (Model.IncludeTime)
        {
            <div class="date-picker__time">
                <input class="form-input" type="number" min="0" max="23" data-date-hour aria-label="Hour" />
                <span>:</span>
                <input class="form-input" type="number" min="0" max="59" data-date-minute aria-label="Minute" />
            </div>
        }
        <div class="date-picker__actions">
            <button type="button" class="button-link" data-date-today>Today</button>
            <button type="button" class="button-link button-link--solid" data-date-apply>Apply</button>
        </div>
    </div>
    <span class="field-validation" data-valmsg-for="@Model.Name" data-valmsg-replace="true"></span>
</div>
