@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span><strong>Sign in</strong>
    </div>
    <h1 class="page-heading">Sign in</h1>
</div>

<section class="surface-panel form-shell">
    <form asp-action="Login" method="post" class="stack-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <label class="form-field">
                <span class="form-label">Email</span>
                <input asp-for="Email" class="form-input" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </label>
            <label class="form-field">
                <span class="form-label">Password</span>
                <input asp-for="Password" class="form-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </label>
            <label class="form-checkline form-field--full">
                <input asp-for="RememberMe" />
                <span>Keep me signed in</span>
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="button-link button-link--solid">Sign in</button>
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="button-link">Create account</a>
        </div>
    </form>

    @if (Model.ExternalLogins.Count > 0)
    {
        <div class="auth-provider-strip">
            @foreach (var provider in Model.ExternalLogins)
            {
                var providerLabel = provider.DisplayName ?? provider.Name;
                var isGoogle = string.Equals(provider.Name, "Google", StringComparison.OrdinalIgnoreCase);
                var providerMark = isGoogle ? "G" : providerLabel.Substring(0, 1);
                <form asp-action="ExternalLogin" method="post" class="auth-provider-form">
                    <input type="hidden" name="provider" value="@provider.Name" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="auth-provider-button @(isGoogle ? "auth-provider-button--google" : null)">
                        <span class="auth-provider-button__mark" aria-hidden="true">@providerMark</span>
                        <span>Continue with @providerLabel</span>
                    </button>
                </form>
            }
        </div>
    }
</section>
