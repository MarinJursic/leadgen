@model MissionRunFormViewModel

@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<div class="form-grid">
    <label class="form-field">
        <span class="form-label">Run code</span>
        <input asp-for="RunCode" class="form-input" />
        <span asp-validation-for="RunCode" class="field-validation"></span>
    </label>
    <partial name="_AutocompleteSelect" model="@(new AutocompleteFieldViewModel
    {
        Name = nameof(Model.BusinessDnaMissionId),
        Label = "Mission",
        Endpoint = Url.Action("Missions", "Lookups") ?? "/lookups/missions",
        Value = Model.BusinessDnaMissionId == Guid.Empty ? null : Model.BusinessDnaMissionId,
        DisplayValue = Model.BusinessDnaMissionName,
        Placeholder = "Search missions"
    })" />
    <partial name="_DateTimeControl" model="@(new DateTimeFieldViewModel
    {
        Name = nameof(Model.StartedAtUtc),
        Label = "Started at",
        Value = Model.StartedAtUtc,
        IsRequired = true
    })" />
    <partial name="_DateTimeControl" model="@(new DateTimeFieldViewModel
    {
        Name = nameof(Model.CompletedAtUtc),
        Label = "Completed at",
        Value = Model.CompletedAtUtc
    })" />
    <label class="form-field">
        <span class="form-label">Status</span>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<MissionStatus>()" class="form-input"></select>
        <span asp-validation-for="Status" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Search region</span>
        <input asp-for="SearchRegion" class="form-input" />
        <span asp-validation-for="SearchRegion" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Token budget</span>
        <input asp-for="TokenBudget" class="form-input" />
        <span asp-validation-for="TokenBudget" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Estimated cost</span>
        <input asp-for="EstimatedCostUsd" class="form-input" />
        <span asp-validation-for="EstimatedCostUsd" class="field-validation"></span>
    </label>
</div>
