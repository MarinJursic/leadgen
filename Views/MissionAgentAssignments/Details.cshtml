@model MissionAgentAssignmentDetailsViewModel
@{
    ViewData["Title"] = "Assignment";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="MissionAgentAssignments" asp-action="Index">Assignments</a><span>/</span>
        <strong>Assignment</strong>
    </div>
    <h1 class="page-heading">Mission assignment</h1>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Responsibility</div>
        <h2 class="detail-panel__title">@Model.Assignment.Responsibility</h2>
        <p class="detail-panel__summary">This assignment binds one swarm agent to one mission run.</p>
    </article>
    <article class="detail-panel">
        <div class="section-header__eyebrow">Context</div>
        <ul class="stack-list">
            <li><strong>Mission</strong><br />@(Model.Mission?.MissionName ?? "Unknown")</li>
            <li><strong>Run</strong><br />@(Model.Run?.RunCode ?? "Unknown")</li>
            <li><strong>Agent</strong><br />@(Model.Agent?.CodeName ?? "Unknown")</li>
            <li><strong>Status</strong><br />@Model.Assignment.Status</li>
        </ul>
    </article>
</section>
