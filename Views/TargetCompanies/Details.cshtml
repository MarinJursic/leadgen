@model TargetCompanyDetailsViewModel
@{
    ViewData["Title"] = Model.Company.Name;
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="TargetCompanies" asp-action="Index">Companies</a><span>/</span>
        <strong>@Model.Company.Name</strong>
    </div>
    <h1 class="page-heading">@Model.Company.Name</h1>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Company profile</div>
        <ul class="stack-list">
            <li><strong>Mission</strong><br />@(Model.Mission?.MissionName ?? "Unknown")</li>
            <li><strong>Run</strong><br />@(Model.Run?.RunCode ?? "Unknown")</li>
            <li><strong>Industry</strong><br />@Model.Company.Industry</li>
            <li><strong>Location</strong><br />@Model.Company.HeadquartersCity, @Model.Company.HeadquartersCountry</li>
            <li><strong>Match score</strong><br />@Model.Company.MatchScore.ToString("0.00")</li>
        </ul>
    </article>
    <article class="detail-panel">
        <div class="section-header__eyebrow">Related contacts</div>
        <ul class="stack-list">
            @foreach (var contact in Model.Company.Contacts)
            {
                <li>
                    <a asp-controller="TargetContacts" asp-action="Details" asp-route-id="@contact.Id">@contact.FullName</a><br />
                    @contact.JobTitle
                </li>
            }
        </ul>
    </article>
</section>
