@model IReadOnlyList<TargetCompany>
@{
    ViewData["Title"] = "Target Companies";
}

<div class="page-header">
    <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span><strong>Companies</strong></div>
    <h1 class="page-heading">Target companies</h1>
    <div class="page-actions">
        <a asp-action="Create" class="button-link button-link--solid">New company</a>
    </div>
</div>

<section class="surface-panel">
    <partial name="_AjaxSearch" model="@(new AjaxSearchViewModel("companies", "Search companies, domains, industries..."))" />
    <table class="list-table" data-search-table>
        <thead>
            <tr><th>Company</th><th>Industry</th><th>Location</th><th>Score</th><th></th></tr>
        </thead>
        <tbody data-search-results>
            @foreach (var company in Model)
            {
                <tr>
                    <td><strong>@company.Name</strong><br /><span>@company.Domain</span></td>
                    <td>@company.Industry</td>
                    <td>@company.HeadquartersCity, @company.HeadquartersCountry</td>
                    <td>@company.MatchScore.ToString("0.00")</td>
                    <td class="table-actions">
                        <a asp-action="Details" asp-route-id="@company.Id" class="button-link">Details</a>
                        <a asp-action="Edit" asp-route-id="@company.Id" class="button-link">Edit</a>
                        <a asp-action="Delete" asp-route-id="@company.Id" class="button-link button-link--danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
