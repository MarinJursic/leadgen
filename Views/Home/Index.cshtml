@model HomeDashboardViewModel
@{
    ViewData["Title"] = "Leadgen 2026";
}

<div class="immersive-page immersive-page--landing" data-landing-page>
    <header class="immersive-topbar">
        <a asp-controller="Home" asp-action="Index" class="immersive-brand">
            <span class="immersive-brand__seal">LG</span>
            <span class="immersive-brand__label">Leadgen 2026</span>
        </a>

        <button type="button" class="immersive-vault-trigger" data-vault-open="landing-vault">
            Vault
        </button>
    </header>

    <div class="immersive-grid"></div>

    <main class="landing-stage">
        <div class="landing-stage__eyebrow">Mission initiation</div>
        <h1 class="landing-stage__title">
            <span>Intelligence</span>
            <span>Swarm</span>
        </h1>
        <p class="landing-stage__summary">
            Autonomous multi-agent discovery. Resolve identity and intent with high-fidelity OSINT swarms.
        </p>

        <form asp-controller="Home" asp-action="Mission" method="get" class="landing-launch">
            <span class="landing-launch__icon" aria-hidden="true">⌕</span>
            <input
                type="text"
                name="dna"
                autocomplete="off"
                placeholder="Input Mission DNA..."
                aria-label="Mission DNA" />
            <button type="submit" class="landing-launch__submit">
                <span>Initiate</span>
                <span aria-hidden="true">›</span>
            </button>
        </form>
    </main>

    <button type="button" class="vault-overlay" data-vault-close="landing-vault" aria-label="Close vault"></button>
    <aside class="vault-sheet" id="landing-vault" aria-hidden="true">
        <div class="vault-sheet__header">
            <div>
                <div class="section-header__eyebrow">Archive</div>
                <h2 class="vault-sheet__title">Vault</h2>
            </div>
            <button type="button" class="vault-sheet__close" data-vault-close="landing-vault" aria-label="Close vault">×</button>
        </div>

        <section class="vault-sheet__section">
            <div class="section-header__eyebrow">Priority leads</div>
            <div class="vault-sheet__stack">
                @foreach (var lead in Model.TopLeads)
                {
                    <article class="vault-sheet__card">
                        <div class="lead-card__meta">
                            <span class="score-pill score-pill--high">Score @lead.LeadgenScore</span>
                            <span class="mission-chip">@lead.MissionName</span>
                        </div>
                        <h3 class="vault-sheet__card-title">@lead.ContactName</h3>
                        <p class="vault-sheet__card-copy">@lead.CompanyName</p>
                        <p class="vault-sheet__card-copy">@lead.AdvantagePoint</p>
                    </article>
                }
            </div>
        </section>

        <section class="vault-sheet__section">
            <div class="section-header__eyebrow">Research surfaces</div>
            <div class="vault-sheet__links">
                @foreach (var entity in Model.EntityNavigation)
                {
                    <a asp-controller="@entity.Controller" asp-action="Index" class="vault-sheet__link">
                        <span>@entity.Label</span>
                        <span>@entity.Count</span>
                    </a>
                }
            </div>
        </section>
    </aside>
</div>
