@model LeadDossierFormViewModel
@{
    ViewData["Title"] = "Edit Dossier";
}

<div class="page-header">
    <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span><a asp-action="Index">Dossiers</a><span>/</span><strong>Edit</strong></div>
    <h1 class="page-heading">Edit lead dossier</h1>
</div>

<section class="surface-panel form-shell">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="stack-form">
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <button type="submit" class="button-link button-link--solid">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="button-link">Cancel</a>
        </div>
    </form>
</section>
