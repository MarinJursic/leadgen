@model LeadDossierFormViewModel

@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<div class="form-grid">
    <partial name="_AutocompleteSelect" model="@(new AutocompleteFieldViewModel
    {
        Name = nameof(Model.MissionRunId),
        Label = "Run",
        Endpoint = Url.Action("Runs", "Lookups") ?? "/lookups/runs",
        Value = Model.MissionRunId == Guid.Empty ? null : Model.MissionRunId,
        DisplayValue = Model.MissionRunName,
        Placeholder = "Search runs"
    })" />
    <partial name="_AutocompleteSelect" model="@(new AutocompleteFieldViewModel
    {
        Name = nameof(Model.TargetCompanyId),
        Label = "Company",
        Endpoint = Url.Action("Companies", "Lookups") ?? "/lookups/companies",
        Value = Model.TargetCompanyId == Guid.Empty ? null : Model.TargetCompanyId,
        DisplayValue = Model.TargetCompanyName,
        Placeholder = "Search companies"
    })" />
    <partial name="_AutocompleteSelect" model="@(new AutocompleteFieldViewModel
    {
        Name = nameof(Model.TargetContactId),
        Label = "Contact",
        Endpoint = Url.Action("Contacts", "Lookups") ?? "/lookups/contacts",
        Value = Model.TargetContactId == Guid.Empty ? null : Model.TargetContactId,
        DisplayValue = Model.TargetContactName,
        Placeholder = "Search contacts"
    })" />
    <label class="form-field">
        <span class="form-label">Score</span>
        <input asp-for="LeadgenScore" class="form-input" />
        <span asp-validation-for="LeadgenScore" class="field-validation"></span>
    </label>
    <label class="form-field form-field--full">
        <span class="form-label">Suggested approach</span>
        <textarea asp-for="SuggestedApproach" class="form-input form-input--textarea"></textarea>
        <span asp-validation-for="SuggestedApproach" class="field-validation"></span>
    </label>
    <label class="form-field form-field--full">
        <span class="form-label">Advantage point</span>
        <textarea asp-for="AdvantagePoint" class="form-input form-input--textarea"></textarea>
        <span asp-validation-for="AdvantagePoint" class="field-validation"></span>
    </label>
    <label class="form-checkbox">
        <input asp-for="IsReadyForOutreach" />
        <span>Ready for outreach</span>
    </label>
    <label class="form-field">
        <span class="form-label">Evidence count</span>
        <input asp-for="SupportingEvidenceCount" class="form-input" />
        <span asp-validation-for="SupportingEvidenceCount" class="field-validation"></span>
    </label>
    <partial name="_DateTimeControl" model="@(new DateTimeFieldViewModel
    {
        Name = nameof(Model.CreatedAtUtc),
        Label = "Created at",
        Value = Model.CreatedAtUtc,
        IsRequired = true
    })" />
    <partial name="_DateTimeControl" model="@(new DateTimeFieldViewModel
    {
        Name = nameof(Model.LastUpdatedAtUtc),
        Label = "Last updated",
        Value = Model.LastUpdatedAtUtc,
        IsRequired = true
    })" />
</div>
