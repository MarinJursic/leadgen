@model IReadOnlyList<LeadDossier>
@{
    ViewData["Title"] = "Lead Dossiers";
}

<div class="page-header">
    <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span><strong>Dossiers</strong></div>
    <h1 class="page-heading">Lead dossiers</h1>
    <div class="page-actions">
        <a asp-action="Create" class="button-link button-link--solid">New dossier</a>
    </div>
</div>

<section class="surface-panel">
    <partial name="_AjaxSearch" model="@(new AjaxSearchViewModel("dossiers", "Search dossier recommendations..."))" />
    <table class="list-table" data-search-table>
        <thead>
            <tr><th>Score</th><th>Advantage point</th><th>Ready</th><th>Updated</th><th></th></tr>
        </thead>
        <tbody data-search-results>
            @foreach (var dossier in Model)
            {
                <tr>
                    <td><strong>@dossier.LeadgenScore</strong></td>
                    <td>@dossier.AdvantagePoint</td>
                    <td>@(dossier.IsReadyForOutreach ? "Yes" : "No")</td>
                    <td>@dossier.LastUpdatedAtUtc.ToString("yyyy-MM-dd")</td>
                    <td class="table-actions">
                        <a asp-action="Details" asp-route-id="@dossier.Id" class="button-link">Details</a>
                        <a asp-action="Edit" asp-route-id="@dossier.Id" class="button-link">Edit</a>
                        <a asp-action="Delete" asp-route-id="@dossier.Id" class="button-link button-link--danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
