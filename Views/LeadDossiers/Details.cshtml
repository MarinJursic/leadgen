@model LeadDossierDetailsViewModel
@{
    ViewData["Title"] = "Lead Dossier";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="LeadDossiers" asp-action="Index">Dossiers</a><span>/</span>
        <strong>Lead dossier</strong>
    </div>
    <h1 class="page-heading">Lead dossier</h1>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Dossier.Id" class="button-link button-link--solid">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Dossier.Id" class="button-link button-link--danger">Delete</a>
    </div>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Dossier summary</div>
        <h2 class="detail-panel__title">Score @Model.Dossier.LeadgenScore</h2>
        <p class="detail-panel__summary">@Model.Dossier.AdvantagePoint</p>
        <p class="detail-panel__summary">@Model.Dossier.SuggestedApproach</p>
    </article>
    <article class="detail-panel">
        <div class="section-header__eyebrow">Context</div>
        <ul class="stack-list">
            <li><strong>Dossier ID</strong><br />@Model.Dossier.Id</li>
            <li><strong>Run ID</strong><br />@Model.Dossier.MissionRunId</li>
            <li><strong>Company ID</strong><br />@Model.Dossier.TargetCompanyId</li>
            <li><strong>Contact ID</strong><br />@Model.Dossier.TargetContactId</li>
            <li><strong>Mission</strong><br />@(Model.Mission?.MissionName ?? "Unknown")</li>
            <li><strong>Run</strong><br />@(Model.Run?.RunCode ?? "Unknown")</li>
            <li><strong>Company</strong><br />@(Model.Company?.Name ?? "Unknown")</li>
            <li><strong>Contact</strong><br />@(Model.Contact?.FullName ?? "Unknown")</li>
            <li><strong>Ready for outreach</strong><br />@(Model.Dossier.IsReadyForOutreach ? "Yes" : "No")</li>
            <li><strong>Supporting evidence</strong><br />@Model.Dossier.SupportingEvidenceCount</li>
            <li><strong>Created</strong><br />@Model.Dossier.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</li>
            <li><strong>Updated</strong><br />@Model.Dossier.LastUpdatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</li>
        </ul>
    </article>
</section>
