@model IReadOnlyList<MissionAttachment>

@if (Model.Count == 0)
{
    <p class="attachment-empty">No documents attached.</p>
}
else
{
    <table class="list-table attachment-table">
        <thead>
            <tr>
                <th>File</th>
                <th>Type</th>
                <th>Size</th>
                <th>Added</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model)
            {
                <tr>
                    <td><a href="@attachment.FilePath" target="_blank" rel="noopener">@attachment.FileName</a></td>
                    <td>@attachment.ContentType</td>
                    <td>@(Math.Ceiling(attachment.FileSize / 1024m)) KB</td>
                    <td>@attachment.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="table-actions">
                        <button type="button" class="button-link button-link--danger" data-attachment-delete="@attachment.Id">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
