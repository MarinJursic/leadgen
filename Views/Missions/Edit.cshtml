@model MissionFormViewModel
@{
    ViewData["Title"] = "Edit Mission";
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-action="Index">Missions</a><span>/</span><strong>Edit</strong>
    </div>
    <h1 class="page-heading">Edit mission</h1>
</div>

<div class="mission-edit-grid">
    <section class="surface-panel form-shell">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="stack-form">
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="button-link button-link--solid">Save changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="button-link">Cancel</a>
            </div>
        </form>
    </section>

    <section class="surface-panel form-shell attachment-panel">
        <div class="section-header">
            <div>
                <div class="section-header__eyebrow">Mission files</div>
                <h2 class="section-header__title">Supporting documents</h2>
            </div>
        </div>

        <form id="missionAttachmentForm"
              class="attachment-upload"
              method="post"
              enctype="multipart/form-data"
              data-upload-url="@Url.Action("UploadAttachment", "Missions", new { missionId = Model.Id })">
            @Html.AntiForgeryToken()
            <input id="missionAttachmentFile" name="file" type="file" class="form-input" />
            <button type="submit" class="button-link button-link--solid">Upload</button>
        </form>

        <div id="missionAttachmentList"
             class="attachment-list"
             data-list-url="@Url.Action("GetAttachments", "Missions", new { missionId = Model.Id })"
             data-delete-template="@Url.Action("DeleteAttachment", "Missions", new { id = "__id__" })">
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("missionAttachmentForm");
            const fileInput = document.getElementById("missionAttachmentFile");
            const list = document.getElementById("missionAttachmentList");

            if (!form || !fileInput || !list) {
                return;
            }

            const token = form.querySelector("input[name='__RequestVerificationToken']")?.value ?? "";

            async function loadAttachments() {
                const response = await fetch(list.dataset.listUrl, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                list.innerHTML = await response.text();
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                if (fileInput.files.length === 0) {
                    return;
                }

                const body = new FormData();
                body.append("file", fileInput.files[0]);

                const response = await fetch(form.dataset.uploadUrl, {
                    method: "POST",
                    headers: { "RequestVerificationToken": token },
                    body
                });

                if (response.ok) {
                    fileInput.value = "";
                    await loadAttachments();
                }
            });

            list.addEventListener("click", async (event) => {
                const button = event.target.closest("[data-attachment-delete]");
                if (!button) {
                    return;
                }

                const url = list.dataset.deleteTemplate.replace("__id__", button.dataset.attachmentDelete);
                const response = await fetch(url, {
                    method: "POST",
                    headers: { "RequestVerificationToken": token }
                });

                if (response.ok) {
                    await loadAttachments();
                }
            });

            loadAttachments();
        })();
    </script>
}
