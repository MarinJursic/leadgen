@model MissionDetailsViewModel
@{
    ViewData["Title"] = Model.Mission.MissionName;
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span>/</span>
        <a asp-controller="Missions" asp-action="Index">Missions</a>
        <span>/</span>
        <strong>@Model.Mission.MissionName</strong>
    </div>
    <div class="section-header">
        <div>
            <div class="section-header__eyebrow">Mission details</div>
            <h1 class="page-heading">@Model.Mission.MissionName</h1>
        </div>
    </div>
</div>

<section class="detail-panel detail-panel--hero">
    <div class="detail-metrics">
        <span class="status-pill">@Model.Mission.Status</span>
        <span class="mission-chip">@Model.Mission.ConfidenceScore.ToString("0.00") confidence</span>
        <span class="mission-chip">@Model.CompanyCount companies</span>
        <span class="mission-chip">@Model.ContactCount contacts</span>
        <span class="mission-chip">@Model.DossierCount dossiers</span>
    </div>
    <h2 class="detail-panel__title">@Model.Mission.ProductName</h2>
    <p class="detail-panel__summary">@Model.Mission.Mechanic</p>
</section>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Business DNA</div>
        <ul class="stack-list">
            <li><strong>Persona</strong><br />@Model.Mission.Persona</li>
            <li><strong>Villain</strong><br />@Model.Mission.Villain</li>
            <li><strong>Delta</strong><br />@Model.Mission.Delta</li>
            <li><strong>Primary surface</strong><br />@Model.Mission.PrimarySurface</li>
            <li><strong>Surface tags</strong><br />@string.Join(", ", Model.Mission.SurfaceTags)</li>
        </ul>
    </article>

    <article class="detail-panel">
        <div class="section-header__eyebrow">Clarification trail</div>
        @if (Model.Mission.ClarificationQuestions.Count == 0)
        {
            <div class="empty-state">No clarification questions were recorded for this mission.</div>
        }
        else
        {
            <ul class="stack-list">
                @foreach (var question in Model.Mission.ClarificationQuestions)
                {
                    <li>
                        <strong>@question.SlotName</strong><br />
                        @question.Prompt
                        @if (!string.IsNullOrWhiteSpace(question.Answer))
                        {
                            <div class="kpi-copy">Answer: @question.Answer</div>
                        }
                    </li>
                }
            </ul>
        }
    </article>

    <article class="detail-panel">
        <div class="section-header__eyebrow">Latest run</div>
        @if (Model.LatestRun is null)
        {
            <div class="empty-state">This mission does not have a recorded run yet.</div>
        }
        else
        {
            <ul class="stack-list">
                <li><strong>Run code</strong><br />@Model.LatestRun.RunCode</li>
                <li><strong>Search region</strong><br />@Model.LatestRun.SearchRegion</li>
                <li><strong>Token budget</strong><br />@Model.LatestRun.TokenBudget</li>
                <li><strong>Estimated cost</strong><br />$@Model.LatestRun.EstimatedCostUsd.ToString("0.00")</li>
            </ul>
        }
    </article>

    <article class="detail-panel">
        <div class="section-header__eyebrow">Run outputs</div>
        <ul class="stack-list">
            @foreach (var run in Model.Mission.Runs)
            {
                <li>
                    <strong>@run.RunCode</strong><br />
                    @run.TargetCompanies.Count companies · @run.LeadDossiers.Count dossiers
                </li>
            }
        </ul>
    </article>
</section>
