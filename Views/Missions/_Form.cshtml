@model MissionFormViewModel

@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<div class="form-grid">
    <label class="form-field">
        <span class="form-label">Mission name</span>
        <input asp-for="MissionName" class="form-input" />
        <span asp-validation-for="MissionName" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Product</span>
        <input asp-for="ProductName" class="form-input" />
        <span asp-validation-for="ProductName" class="field-validation"></span>
    </label>
    <label class="form-field form-field--full">
        <span class="form-label">Mechanic</span>
        <textarea asp-for="Mechanic" class="form-input form-input--textarea"></textarea>
        <span asp-validation-for="Mechanic" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Primary surface</span>
        <input asp-for="PrimarySurface" class="form-input" />
        <span asp-validation-for="PrimarySurface" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Surface tags</span>
        <input asp-for="SurfaceTagsText" class="form-input" />
        <span asp-validation-for="SurfaceTagsText" class="field-validation"></span>
    </label>
    <label class="form-field form-field--full">
        <span class="form-label">Persona</span>
        <textarea asp-for="Persona" class="form-input form-input--textarea"></textarea>
        <span asp-validation-for="Persona" class="field-validation"></span>
    </label>
    <label class="form-field form-field--full">
        <span class="form-label">Villain</span>
        <textarea asp-for="Villain" class="form-input form-input--textarea"></textarea>
        <span asp-validation-for="Villain" class="field-validation"></span>
    </label>
    <label class="form-field form-field--full">
        <span class="form-label">Delta</span>
        <textarea asp-for="Delta" class="form-input form-input--textarea"></textarea>
        <span asp-validation-for="Delta" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Confidence</span>
        <input asp-for="ConfidenceScore" class="form-input" />
        <span asp-validation-for="ConfidenceScore" class="field-validation"></span>
    </label>
    <label class="form-field">
        <span class="form-label">Status</span>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<MissionStatus>()" class="form-input"></select>
        <span asp-validation-for="Status" class="field-validation"></span>
    </label>
    <partial name="_DateTimeControl" model="@(new DateTimeFieldViewModel
    {
        Name = nameof(Model.CreatedAtUtc),
        Label = "Created at",
        Value = Model.CreatedAtUtc,
        IsRequired = true
    })" />
</div>
