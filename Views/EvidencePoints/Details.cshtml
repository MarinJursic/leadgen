@model EvidencePointDetailsViewModel
@{
    ViewData["Title"] = Model.Evidence.Label;
}

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>/</span>
        <a asp-controller="EvidencePoints" asp-action="Index">Evidence</a><span>/</span>
        <strong>@Model.Evidence.Label</strong>
    </div>
    <h1 class="page-heading">@Model.Evidence.Label</h1>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Evidence.Id" class="button-link button-link--solid">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Evidence.Id" class="button-link button-link--danger">Delete</a>
    </div>
</div>

<section class="detail-grid">
    <article class="detail-panel">
        <div class="section-header__eyebrow">Evidence summary</div>
        <h2 class="detail-panel__title">@Model.Evidence.Kind</h2>
        <p class="detail-panel__summary">@Model.Evidence.Summary</p>
        <p class="detail-panel__summary">@Model.Evidence.RawSnippet</p>
    </article>
    <article class="detail-panel">
        <div class="section-header__eyebrow">Context</div>
        <ul class="stack-list">
            <li><strong>Evidence ID</strong><br />@Model.Evidence.Id</li>
            <li><strong>Mission</strong><br />@(Model.Mission?.MissionName ?? "Unknown")</li>
            <li><strong>Company</strong><br />@(Model.Company?.Name ?? "Unknown")</li>
            <li><strong>Contact</strong><br />@(Model.Contact?.FullName ?? "Unknown")</li>
            <li><strong>Platform</strong><br />@Model.Evidence.SourcePlatform</li>
            <li><strong>Captured</strong><br />@Model.Evidence.CapturedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</li>
            <li><strong>Confidence</strong><br />@Model.Evidence.ConfidenceScore.ToString("0.00")</li>
            <li><strong>Qualification signal</strong><br />@(Model.Evidence.IsQualificationSignal ? "Yes" : "No")</li>
            <li><strong>Source URL</strong><br /><a href="@Model.Evidence.SourceUrl" target="_blank" rel="noreferrer">@Model.Evidence.SourceUrl</a></li>
        </ul>
    </article>
</section>
