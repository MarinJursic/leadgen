@model IReadOnlyList<string>
@{
    ViewData["Title"] = "Logs";
}

<section class="page-title">
    <div>
        <p class="metric mb-1">Admin</p>
        <h1 class="h2 mb-0">Safe logs</h1>
    </div>
</section>

<div class="surface-panel">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No log lines yet.</p>
    }
    else
    {
        <pre class="log-block">@string.Join(Environment.NewLine, Model)</pre>
    }
</div>
