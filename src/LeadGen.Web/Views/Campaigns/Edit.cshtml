@model CampaignFormModel
@{
    ViewData["Title"] = "Edit campaign";
}

<section class="page-title">
    <div>
        <p class="metric mb-1">Campaign</p>
        <h1 class="h2 mb-0">Edit campaign</h1>
    </div>
    <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@Model.Id">Details</a>
</section>

<div class="surface-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <partial name="_Form" model="Model" />
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-dark" type="submit">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
