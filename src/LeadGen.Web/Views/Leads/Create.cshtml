@model LeadFormModel
@{
    ViewData["Title"] = "Create lead";
}

<section class="page-title">
    <div>
        <p class="metric mb-1">Lead</p>
        <h1 class="h2 mb-0">Create lead</h1>
    </div>
    <a class="btn btn-outline-dark" asp-action="Index">Back</a>
</section>

<div class="surface-panel">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <button class="btn btn-dark mt-4" type="submit">Save lead</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
