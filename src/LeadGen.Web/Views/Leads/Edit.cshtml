@model LeadFormModel
@{
    ViewData["Title"] = "Edit lead";
}

<section class="page-title">
    <div>
        <p class="metric mb-1">Lead</p>
        <h1 class="h2 mb-0">Edit lead</h1>
    </div>
    <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@Model.Id">Details</a>
</section>

<div class="surface-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <partial name="_Form" model="Model" />
        <button class="btn btn-dark mt-4" type="submit">Save changes</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
